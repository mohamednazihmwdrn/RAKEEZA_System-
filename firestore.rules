rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and tenancy validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'nazihm338@gmail.com' ||
        request.auth.token.role == 'owner' ||
        (request.auth.token.firebase != null && request.auth.token.firebase.sign_in_provider == 'password')
      );
    }

    function isMemberOf(companyId) {
      return isAuthenticated() && (
        isOwner() ||
        request.auth.token.companyId == companyId ||
        request.auth.uid == companyId ||
        (resource != null && resource.data.companyId == companyId)
      );
    }

    function isValidWrite(companyId) {
      return isAuthenticated() && (
        isOwner() ||
        request.auth.token.companyId == companyId ||
        (request.resource.data.companyId == companyId)
      );
    }

    // Health check endpoint for connection testing
    match /test/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Tenant-isolated business operations, invoices, inventory, sub-collections and archives
    match /tenants/{companyId} {
      allow read: if isMemberOf(companyId);
      allow write: if isValidWrite(companyId);

      match /{document=**} {
        allow read: if isMemberOf(companyId);
        allow write: if isValidWrite(companyId);
      }
    }

    // Registered tenant companies metadata and users catalog
    match /companies/{companyId} {
      allow read: if isMemberOf(companyId);
      allow write: if isValidWrite(companyId);

      match /{document=**} {
        allow read: if isMemberOf(companyId);
        allow write: if isValidWrite(companyId);
      }
    }

    // Owner configuration, license keys, and trial registries
    match /ownerSettings/{docId} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    // Audit logs collection (append-only)
    match /auditLogs/{auditId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
