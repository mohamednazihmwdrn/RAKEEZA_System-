rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Health check endpoint for connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // Tenant-isolated business operations, invoices, inventory, sub-collections and archives
    match /tenants/{companyId} {
      allow read, write: if true;

      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Registered tenant companies metadata and users catalog
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // Owner configuration, license keys, and trial registries
    match /ownerSettings/{docId} {
      allow read, write: if true;
    }
  }
}
